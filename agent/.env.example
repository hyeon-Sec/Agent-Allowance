# Default selection: anthropic | gemini | openai. The dashboard can override it per request.
AI_PROVIDER=anthropic

# Configure only the providers you want to use. Keys stay on the server.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.3-codex
# Optional: point the OpenAI SDK at a local OpenAI-compatible proxy.
# OPENAI_BASE_URL=http://127.0.0.1:10531/v1
# OpenAI uses the Responses API. ChatGPT/Codex subscription access is separate.
# Missing keys disable only that provider's chat, not policy browsing or attack simulations.

# Sui testnet — IDs and agent key only. Never put an owner key in this file.
PACKAGE_ID=
ALLOWANCE_ID=
OWNER_CAP_ID=
AGENT_SECRET_KEY=

# Optional overrides. The server binds only to 127.0.0.1.
PORT=8787
SUI_FULLNODE_URL=https://fullnode.testnet.sui.io:443
WALRUS_PUBLISHER=https://publisher.walrus-testnet.walrus.space
WALRUS_AGGREGATOR=https://aggregator.walrus-testnet.walrus.space
WALRUS_EPOCHS=5
